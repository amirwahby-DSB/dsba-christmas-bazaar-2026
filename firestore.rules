rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "Bu6cZ8g8ckMohXvpPUa63oAFjw93";
    }

    match /tents/{tentId} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.auth == null
          && resource.data.status == "available"
          && request.resource.data.status == "pending"
          && request.resource.data.bookingId is string
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == "pending"
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.tentIds.hasAny([tentId])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "bookingId"])
        );
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow create: if request.auth == null
        && request.resource.data.keys().hasAll(["ref","name","phone","business","tentIds","total","paymentMethod","status","paymentStatus","createdAt"])
        && request.resource.data.ref == bookingId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 30
        && request.resource.data.business is string
        && request.resource.data.business.size() <= 120
        && request.resource.data.tentIds is list
        && request.resource.data.tentIds.size() >= 1
        && request.resource.data.tentIds.size() <= 10
        && request.resource.data.total is number
        && request.resource.data.paymentMethod in ["إنستا باي","كاش بالمدرسة"]
        && request.resource.data.status == "pending"
        && request.resource.data.paymentStatus == "unconfirmed";
      allow update, delete: if isAdmin();
    }
  }
}
